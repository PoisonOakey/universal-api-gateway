# ──────────────
# Gateway Configuration
# ──────────────

# Comma-separated list of allowed origins for CORS.
# Default: http://localhost,http://localhost:30000
ALLOWED_ORIGINS=http://localhost,http://localhost:30000

# Bearer token for authenticating proxy routes.
# If unset, authentication is disabled (not recommended for production).
# API_AUTH_TOKEN=changeme-generate-your-own
